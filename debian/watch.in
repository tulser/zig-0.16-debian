Version: 5

# Alt. URIs:
# https://ziglang.org/download/0.16.0/zig-0.16.0.tar.xz
# https://ziglang.org/download/0.16.0/zig-0.16.0.tar.xz.minisig
Source: https://codeberg.org/ziglang/zig/tags/
Matching-Pattern: https://codeberg.org/ziglang/zig/archive/(@ZIG_VERSION@.[0-9\.]*)@ARCHIVE_EXT@
Dversion-Mangle: auto
Repack: yes
Repack-Suffix: +dfsg
## FIXME: Tarballs are signed with minisign, which is presently unsupported
## `upstream/signing-key` has the minisign key to verify the upstream tarballs
#Pgp-Sig-Url-Mangle: s/$/.minisig/
