Source: zig-@ZIG_VERSION@
Maintainer: W. Connor Yates <self@wcyates.xyz>
Build-Depends:
 debhelper-compat (= 13),
 chrpath,
 clang-@LLVM_VERSION_MAJOR@,
 cmake (>= 3.15),
 help2man,
 libclang-@LLVM_VERSION_MAJOR@-dev,
 libclang-cpp@LLVM_VERSION_MAJOR@-dev,
 liblld-@LLVM_VERSION_MAJOR@-dev,
 llvm-@LLVM_VERSION_MAJOR@-dev,
 pkgconf,
Standards-Version: 4.7.4
Section: devel
Homepage: https://ziglang.org/
Vcs-Browser: https://salsa.debian.org/zig-team/zig-0.16
Vcs-Git: https://salsa.debian.org/zig-team/zig-0.16.git

Package: zig-@ZIG_VERSION@
Architecture: any
Multi-Arch: foreign
Depends:
 libstd-zig@ZIG_VERSION@-dev (= ${source:Version}),
 ${misc:Depends},
 ${shlibs:Depends},
Suggests:
 zig,
Description: General-purpose imperative language
 Zig is a general-purpose programming language and toolchain
 for maintaining robust, optimal and reusable software.
 .
 This package contains the binary for Zig.

Package: libstd-zig@ZIG_VERSION@-dev
Architecture: all
Multi-Arch: foreign
Depends:
 libclang-common-@LLVM_VERSION_MAJOR@-dev,
 ${misc:Depends},
Enhances:
 zig-@ZIG_VERSION@,
Description: General-purpose imperative language (stdlib)
 Zig is a general-purpose programming language and toolchain
 for maintaining robust, optimal and reusable software.
 .
 This package contains the Zig standard library.
